# Bước 3: Admin tạo booking với số tiền thanh toán cụ thể
POST http://localhost:3000/bookings/staff/create
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
Content-Type: application/json

{
  "propertyId": "507f1f77bcf86cd799439011",
  "listingId": "507f1f77bcf86cd799439012",
  "checkInDate": "2024-12-30",
  "checkOutDate": "2025-01-02",
  "guests": 3,
  "infants": 1,
  "guest_name": "Lê Văn C",
  "guest_email": "guest3@example.com",
  "guest_phone": "0123456789",
  "note": "Admin tạo booking với số tiền custom",
  "status": "confirmed",
  "payment_status": "unpaid",
  "payment_method": "vnpay",
  "create_payment_url": true,
  "payment_method_choice": "vnpay",
  "payment_type": "full",
  "payment_amount": 1500000,
  "payment_description": "Admin tạo booking - số tiền custom",
  "payment_return_url": "http://localhost:5173/admin/bookings?payment=success"
}

