### Test Admin tạo booking với VNPay tích hợp

# Bước 1: Admin tạo booking với VNPay tự động
POST http://localhost:3000/bookings/staff/create
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
Content-Type: application/json

{
  "propertyId": "507f1f77bcf86cd799439011",
  "listingId": "507f1f77bcf86cd799439012",
  "checkInDate": "2024-12-20",
  "checkOutDate": "2024-12-22",
  "guests": 2,
  "infants": 0,
  "guest_name": "Nguyễn Văn A",
  "guest_email": "guest@example.com",
  "guest_phone": "0123456789",
  "specialRequests": "Booking test cho VNPay tích hợp",
  "note": "Admin tạo booking với VNPay tích hợp",
  "status": "confirmed",
  "payment_status": "unpaid",
  "payment_method": "vnpay",
  "create_payment_url": true,
  "payment_method_choice": "vnpay",
  "payment_type": "full",
  "payment_description": "Admin tạo booking với VNPay",
  "payment_return_url": "http://localhost:5173/admin/bookings?payment=success"
}

