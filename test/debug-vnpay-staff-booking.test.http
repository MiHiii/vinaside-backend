### 4. Test endpoint VNPay trực tiếp (endpoint cũ)
POST {{baseUrl}}/bookings/68a9e4cf13cd0fc56b50fd29/payment/staff
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "propertyId": "68a1577ceebed1cbdf09c9fb",
  "paymentMethod": "vnpay",
  "paymentType": "full",
  "description": "Test VNPay direct payment",
  "returnUrl": "http://localhost:5173/admin/bookings/payment-success"
}

